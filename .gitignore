fuzz/corpus/
mutants.out*/

# WebAssembly build output
crypto-wasm/pkg/

# Node (web/)
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
.npm/

# Tests, coverage and mutation testing
coverage/
.nyc_output/
playwright-report/
test-results/
.stryker-tmp/
reports/mutation/

