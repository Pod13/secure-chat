{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-chat.invalid/schema/invite-create-request.json",
  "title": "POST /invites request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "service",
        "contact",
        "group"
      ]
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "max_uses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "required": [
    "kind",
    "expires_at",
    "max_uses"
  ],
  "examples": [
    {
      "kind": "service",
      "expires_at": 0,
      "max_uses": 1
    }
  ]
}
