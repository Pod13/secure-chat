{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-chat.invalid/schema/auth-token-response.json",
  "title": "POST /auth/token response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    },
    "expires_in": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    }
  },
  "required": [
    "token",
    "expires_in"
  ],
  "examples": [
    {
      "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expires_in": 1
    }
  ]
}
