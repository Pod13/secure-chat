{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-chat.invalid/schema/invite-create-response.json",
  "title": "POST /invites response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "invite_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    }
  },
  "required": [
    "invite_token"
  ],
  "examples": [
    {
      "invite_token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  ]
}
