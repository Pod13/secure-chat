{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-chat.invalid/schema/link-request-create.json",
  "title": "POST /devices/link-requests request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    },
    "ephemeral_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    }
  },
  "required": [
    "device_public_key",
    "ephemeral_public_key"
  ],
  "examples": [
    {
      "device_public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "ephemeral_public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  ]
}
