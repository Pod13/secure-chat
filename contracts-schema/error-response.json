{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-chat.invalid/schema/error-response.json",
  "title": "Error response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "invalid_request",
        "unauthorized",
        "not_found",
        "rate_limited",
        "too_large",
        "conflict",
        "internal"
      ]
    },
    "retry_after": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    }
  },
  "required": [
    "code"
  ],
  "examples": [
    {
      "code": "invalid_request"
    }
  ]
}
