{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-chat.invalid/schema/key-packages-fetch-request.json",
  "title": "POST /key-packages/fetch request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    }
  },
  "required": [
    "token"
  ],
  "examples": [
    {
      "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  ]
}
