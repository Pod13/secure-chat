{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-chat.invalid/schema/account-delete-request.json",
  "title": "DELETE /accounts/me request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 86,
      "maxLength": 86
    }
  },
  "required": [
    "signature"
  ],
  "examples": [
    {
      "signature": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  ]
}
