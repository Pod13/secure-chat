{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-chat.invalid/schema/auth-challenge-response.json",
  "title": "POST /auth/challenge response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    }
  },
  "required": [
    "nonce"
  ],
  "examples": [
    {
      "nonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  ]
}
